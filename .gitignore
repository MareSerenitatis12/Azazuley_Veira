# Python bytecode and caches
__pycache__/
*.py[cod]
*.pyo
*.pyd.tmp

# Test and analysis caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
.hypothesis/

# Notebook/editor/OS noise
.ipynb_checkpoints/
.DS_Store
Thumbs.db
*~
*.swp
*.swo

# Local environments and package metadata
.venv/
venv/
env/
*.egg-info/
.eggs/

# Local backups and scratch state
.BACKUPS/
.backups/
.surgical_backups/
*.bak
*.orig.tmp
*.tmp
*.temp

# Generic build output
build/
dist/
*.log

# Tests are local development material
tests/

# Installer directory: ignore everything except finished release installers
installers/**
!installers/linux_ubuntu/
!installers/windows/
!installers/mac/
