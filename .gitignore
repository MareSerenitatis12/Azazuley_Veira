# Python bytecode and caches
__pycache__/
*.py[cod]
*.pyo
*.pyd.tmp

# Test and analysis caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
.hypothesis/

# Notebook/editor/OS noise
.ipynb_checkpoints/
.DS_Store
Thumbs.db
*~
*.swp
*.swo

# Local environments and package metadata
.venv/
venv/
env/
*.egg-info/
.eggs/

# Local backups and scratch state
.BACKUPS/
.backups/
.surgical_backups/
*.bak
*.orig.tmp
*.tmp
*.temp

# Generic build output
build/
dist/
*.log

# Tests are local development material
tests/

# Private/local installer build machinery
installers/.build/

# Android local toolchains, caches, and signing material
installers/android/android-sdk/
installers/android/android-ndk/
installers/android/host-venv/
installers/android/python-host/
installers/android/p4a-source/
installers/android/toolchain/
installers/android/app/.buildozer/
installers/android/**/*.log
installers/android/**/*.keystore
installers/android/**/*.jks
installers/android/**/*.p12
installers/android/**/*.pem
installers/android/**/*.key

# Keep the public Android app source/build recipe and release artifacts
!installers/android/
!installers/android/app/
!installers/android/app/**
installers/android/app/.buildozer/
installers/android/app/**/*.log
installers/android/app/**/*.keystore
installers/android/app/**/*.jks
installers/android/app/**/*.p12
installers/android/app/**/*.pem
installers/android/app/**/*.key

